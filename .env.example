# Server only. Copy to .env.local, enter your key, and restart npm run dev.
DEEPSEEK_API_KEY=
SHALLOWGROOVE_MODEL=deepseek-v4-flash
# Optional per-response output budget (including reasoning); default 8192.
# Choose a value supported by your configured provider/model.
# SHALLOWGROOVE_MAX_TOKENS=16384
# Optional: a DeepSeek Messages-compatible endpoint (not OpenAI Chat Completions).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Optional: data directory on a filesystem with hard links and file locks.
# SHALLOWGROOVE_DATA_DIR=/absolute/path/to/application-data
