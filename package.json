{
  "name": "shallowgroove",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "check:patches": "node --experimental-strip-types scripts/check-patch-bank.mjs",
    "check:effects": "node scripts/check-effects.mjs",
    "dev:network": "SHALLOWGROOVE_NETWORK=1 vite --host 0.0.0.0",
    "package:mac": "npm run build && node desktop/package.mjs",
    "package:win": "npm run build && node desktop/package-win.mjs",
    "package:portable": "npm run package:win && node desktop/package-portable.mjs",
    "package:installer": "npm run package:win && node desktop/package-installer.mjs",
    "icons": "node desktop/generate-icons.mjs",
    "package:mac:private": "npm run build && node desktop/package.mjs --private",
    "package:win:private": "npm run build && node desktop/package-win.mjs --private",
    "package:portable:private": "npm run package:win:private && node desktop/package-portable.mjs --private",
    "package:installer:private": "npm run package:win:private && node desktop/package-installer.mjs --private",
    "build:native": "cmake -S native -B build-native -DCMAKE_BUILD_TYPE=Release && cmake --build build-native --config Release --target ShallowGrooveEngine ShallowGrooveRack_VST3 ShallowGrooveFX_VST3 --parallel 3",
    "check:native": "node --experimental-strip-types scripts/check-native-audio.mjs",
    "dev:desktop": "node scripts/prepare-assets.mjs && electron . --vite-dev --native-preview"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@grame/faustwasm": "^0.20.1",
    "fflate": "0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "shallowgroove-music-tools": "file:server/music-plugin",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "midi-file": "1.2.4",
    "node": "^24.22.2",
    "pdfjs-dist": "5.4.394",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "undici": "8.12.2",
    "zod": "4.6.6",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0"
  },
  "main": "desktop/main.cjs"
}
